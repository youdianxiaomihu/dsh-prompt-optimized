  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/youdianxiaomihu/dsh-prompt-optimized.git"
  },
  "homepage": "https://github.com/youdianxiaomihu/dsh-prompt-optimized#readme",
  "bugs": {
