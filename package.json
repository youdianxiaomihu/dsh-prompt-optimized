  },
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "prompt-optimizer",
    "skill"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/prompt-optimizer/SKILL.md",
